generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  super_admin
  admin
  member
  viewer
}

enum InviteRole {
  admin
  member
  viewer
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired
}

enum AuthorStatus {
  active
  inactive
}

enum WebtoonStatus {
  ongoing
  completed
  hiatus
  draft
}

enum EpisodeStatus {
  published
  draft
  scheduled
}

enum MediaKind {
  image
  pdf
}

model Meta {
  id Int @id @default(autoincrement())
}

model StaffUser {
  id               String               @id @default(uuid())
  email            String               @unique
  displayName      String
  role             StaffRole
  passwordHash     String
  totpEnabled      Boolean              @default(false)
  totpSecret       String?
  totpBackupHashes String[]             @default([])
  createdAt        DateTime             @default(now())
  invites          StaffInvite[]        @relation("StaffInviter")
  passwordResets   StaffPasswordReset[]
  readerBroadcasts ReaderBroadcast[]
}

model StaffPasswordReset {
  id         String    @id @default(uuid())
  userId     String
  user       StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

model StaffInvite {
  id         String       @id @default(uuid())
  email      String
  role       InviteRole
  tokenHash  String
  status     InviteStatus @default(pending)
  inviterId  String
  inviter    StaffUser    @relation("StaffInviter", fields: [inviterId], references: [id])
  createdAt  DateTime     @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?
}

model Author {
  id            String       @id @default(uuid())
  name          Json
  bio           Json?
  avatar        String?
  followerCount Int          @default(0)
  status        AuthorStatus @default(active)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  webtoons      Webtoon[]
}

model Genre {
  id        String         @id @default(uuid())
  name      Json
  slug      String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  webtoons  WebtoonGenre[]
}

model Webtoon {
  id              String         @id @default(uuid())
  title           Json
  description     Json
  coverImage      String?
  coverColor      String         @default("")
  authorId        String
  author          Author         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  tags            String[]
  status          WebtoonStatus
  isPremium       Boolean        @default(false)
  viewCount       Int            @default(0)
  likeCount       Int            @default(0)
  rating          Float          @default(0)
  contentRating   String
  spotlight       Boolean        @default(false)
  spotlightOrder  Int?
  weeklyViewCount Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  genres          WebtoonGenre[]
  episodes        Episode[]
}

model WebtoonGenre {
  webtoonId String
  genreId   String
  webtoon   Webtoon @relation(fields: [webtoonId], references: [id], onDelete: Cascade)
  genre     Genre   @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([webtoonId, genreId])
}

model Episode {
  id            String        @id @default(uuid())
  webtoonId     String
  webtoon       Webtoon       @relation(fields: [webtoonId], references: [id], onDelete: Restrict)
  title         Json
  description   Json?
  images        String[]
  imageSizes    Json?
  isPremium     Boolean       @default(false)
  coinPrice     Int           @default(0)
  viewCount     Int           @default(0)
  likeCount     Int           @default(0)
  episodeNumber Int
  status        EpisodeStatus
  freeAt        DateTime?
  scheduledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([webtoonId, episodeNumber])
}

model MediaAsset {
  id          String    @id @default(uuid())
  key         String    @unique
  url         String
  name        String
  contentType String
  kind        MediaKind
  size        Int
  category    String    @default("general")
  createdAt   DateTime  @default(now())
}

model CoinPackage {
  id        String   @id @default(uuid())
  coins     Int
  price     Int
  bonus     Int?
  popular   Boolean?
  bestValue Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CommentStatus {
  visible
  hidden
  deleted
}

model Comment {
  id        String        @id @default(uuid())
  userId    String
  user      Json
  webtoonId String
  episodeId String
  content   Json
  likeCount Int           @default(0)
  status    CommentStatus @default(visible)
  createdAt DateTime      @default(now())
}

model ReaderComment {
  id         String               @id
  episodeKey String
  userId     String
  content    String
  parentId   String?
  spoiler    Boolean              @default(false)
  reported   Boolean              @default(false)
  isEdited   Boolean              @default(false)
  createdAt  DateTime
  likes      ReaderCommentLike[]

  @@index([episodeKey])
}

model ReaderCommentLike {
  commentId String
  userId    String
  comment   ReaderComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
}

model ReaderUser {
  id               String                   @id
  email            String                   @unique
  username         String                   @unique
  displayName      String
  avatar           String?
  bio              String                   @default("")
  passwordHash     String
  createdAt        DateTime
  lastLoginAt      DateTime?
  refreshTokens    RefreshToken[]
  passwordResets   ReaderPasswordReset[]
  wallet           Wallet?
  transactions     WalletTransaction[]
  unlocks          WalletUnlock[]
  librarySubscribes LibrarySubscribe[]
  libraryHistory   LibraryHistory[]
  libraryLikes     LibraryLike[]
  notifications    ReaderNotification[]
  prefs            ReaderUserPrefs?
  pushSubscriptions ReaderPushSubscription[]
}

model RefreshToken {
  jti    String     @id
  userId String
  user   ReaderUser @relation(fields: [userId], references: [id])
}

model ReaderPasswordReset {
  id        String     @id
  userId    String
  tokenHash String     @unique
  expiresAt DateTime
  user      ReaderUser @relation(fields: [userId], references: [id])
}

model Wallet {
  userId  String     @id
  balance Int
  seeded  Boolean
  user    ReaderUser @relation(fields: [userId], references: [id])
}

enum WalletTxnType {
  purchase
  spend
  refund
  bonus
  demo_topup
}

model WalletTransaction {
  id          String        @id
  userId      String
  type        WalletTxnType
  amount      Int
  description String
  balance     Int
  createdAt   DateTime
  packageId   String?
  episodeKey  String?
  user        ReaderUser    @relation(fields: [userId], references: [id])
}

model WalletUnlock {
  userId     String
  episodeKey String
  user       ReaderUser @relation(fields: [userId], references: [id])

  @@id([userId, episodeKey])
}

model LibrarySubscribe {
  userId                    String
  webtoonId                 String
  addedAt                   DateTime
  notifyMuted               Boolean @default(false)
  lastNotifiedEpisodeNumber Int?
  user                      ReaderUser @relation(fields: [userId], references: [id])

  @@id([userId, webtoonId])
}

model LibraryHistory {
  userId             String
  webtoonId          String
  episodeNumber      Int
  lastReadAt         DateTime
  scrollRatio        Float?
  readEpisodeNumbers Int[]    @default([])
  user               ReaderUser @relation(fields: [userId], references: [id])

  @@id([userId, webtoonId])
}

model LibraryLike {
  userId    String
  webtoonId String
  likedAt   DateTime
  user      ReaderUser @relation(fields: [userId], references: [id])

  @@id([userId, webtoonId])
}

enum ReaderNotificationType {
  new_episode
  comment_reply
  system
  promotion
}

model ReaderNotification {
  userId        String
  id            String
  type          ReaderNotificationType
  titleKey      String
  message       String
  isRead        Boolean
  createdAt     DateTime
  href          String?
  webtoonId     String?
  episodeNumber Int?
  user          ReaderUser @relation(fields: [userId], references: [id])

  @@id([userId, id])
}

model ReaderPushSubscription {
  userId   String
  endpoint String
  p256dh   String
  auth     String
  user     ReaderUser @relation(fields: [userId], references: [id])

  @@id([userId, endpoint])
}

enum ReaderFontSize {
  sm
  md
  lg
}

enum ReaderImageFit {
  fit
  full
}

model ReaderUserPrefs {
  userId       String         @id
  newEpisode   Boolean        @default(true)
  commentReply Boolean        @default(true)
  promotion    Boolean        @default(true)
  darkMode     Boolean        @default(true)
  brightness   Float          @default(0.9)
  fontSize     ReaderFontSize @default(md)
  imageFit     ReaderImageFit @default(fit)
  user         ReaderUser     @relation(fields: [userId], references: [id])
}

enum StaffNotificationType {
  system
  report
  payment
  content
}

model StaffNotification {
  id        String                 @id @default(uuid())
  type      StaffNotificationType
  title     Json
  message   Json
  isRead    Boolean                @default(false)
  createdAt DateTime               @default(now())
  actionUrl String?
}

enum PlatformLanguage {
  en
  mm
}

model PlatformSettings {
  id                 String           @id
  maintenanceMode    Boolean
  allowRegistration  Boolean
  contactEmail       String
  defaultLanguage    PlatformLanguage
  updatedAt          DateTime         @updatedAt
}

enum ReaderBroadcastType {
  system
  promotion
}

enum ReaderBroadcastAudience {
  all
  selected
}

enum ReaderBroadcastStatus {
  sending
  sent
  failed
}

model ReaderBroadcast {
  id            String                   @id @default(uuid())
  type          ReaderBroadcastType
  title         Json
  message       Json
  href          String?
  audience      ReaderBroadcastAudience
  readerIds     Json
  status        ReaderBroadcastStatus    @default(sending)
  createdById   String
  createdBy     StaffUser                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  inboxCount    Int                      @default(0)
  emailed       Int                      @default(0)
  pushed        Int                      @default(0)
  skippedPref   Int                      @default(0)
  failureReason String?
  createdAt     DateTime                 @default(now())
}

model AboutHistory {
  id          String   @id @default(uuid())
  year        Int
  month       Int
  title       Json
  description Json
  photoUrl    String?
  sortOrder   Int
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([year, month])
}

model AboutTeamMember {
  id        String   @id @default(uuid())
  name      Json
  role      Json
  photoUrl  String?
  sortOrder Int
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model AboutTeamMeta {
  id             String   @id
  deck           Json
  standInNote    Json
  standInVisible Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model PressMeta {
  id                   String   @id
  copy                 Json
  zipUrl               String
  contactEmail         String
  facts                Json
  palette              Json
  assets               Json
  spokespersonMemberId String?
  updatedAt            DateTime @updatedAt
}

model PressNews {
  id        String   @id @default(uuid())
  title     Json
  body      Json
  href      String?
  sortOrder Int
  published Boolean  @default(true)
  demoBadge Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model PressStill {
  id        String   @id @default(uuid())
  title     Json
  imageUrl  String
  sortOrder Int
  published Boolean  @default(true)
  demoBadge Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model FaqMeta {
  id             String   @id
  nextItemNumber Int
  updatedAt      DateTime @updatedAt
}

model FaqItem {
  id           String   @id
  category     String
  question     Json
  answer       Json
  relatedTo    String?
  relatedLabel Json?
  sortOrder    Int
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sortOrder])
}

model CookieMeta {
  id            String   @id
  effectiveDate String
  copy          Json
  glance        Json
  updatedAt     DateTime @updatedAt
}

model CookieStorageRow {
  id          String   @id
  storageKey  String   @unique
  label       Json
  description Json
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model PrivacyMeta {
  id            String   @id
  seoDesc       Json
  glance        Json
  effectiveDate DateTime
  updatedAt     DateTime @updatedAt
}

model PrivacySection {
  id           String   @id @default(uuid())
  slug         String   @unique
  kind         String
  headingLevel String
  title        Json
  body         Json
  bullets      Json
  sortOrder    Int
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sortOrder])
}

model TermsMeta {
  id            String   @id
  seoDesc       Json
  glance        Json
  effectiveDate DateTime
  updatedAt     DateTime @updatedAt
}

model TermsSection {
  id           String   @id @default(uuid())
  slug         String   @unique
  kind         String
  headingLevel String
  title        Json
  body         Json
  bullets      Json
  sortOrder    Int
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sortOrder])
}
