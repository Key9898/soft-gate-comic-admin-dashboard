PORT=3000
DATABASE_URL=postgresql://softgate:softgate@localhost:5432/softgate
JWT_SECRET=change-me-not-a-real-secret
MEDIA_UPLOAD_DIR=./uploads
MEDIA_PUBLIC_BASE_URL=http://localhost:3000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=fake
R2_SECRET_ACCESS_KEY=fake
R2_BUCKET=
# Default endpoint is https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
R2_KEY_PREFIX=admin
# Extra origins (e.g. http://localhost:5174 or a later Vercel URL) are comma-separated. No wildcards.
CORS_ORIGINS=http://localhost:5173
COOKIE_SAMESITE=lax
# Blank COOKIE_SECURE follows NODE_ENV=production. SameSite=none always sets Secure.
COOKIE_SECURE=
BREVO_API_KEY=fake
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SoftGate Comic
# Admin SPA origin for invite emails. Production must set the real Admin URL (not API :3000).
ADMIN_APP_URL=http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
OIDC_ISSUER=
OIDC_CLIENT_ID=fake
OIDC_CLIENT_SECRET=fake
